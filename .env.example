DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST, e.g. https://my-app.example.com (Vercel's own URLs are added automatically)
CSRF_TRUSTED_ORIGINS=
# Default is SQLite in the project folder. Neon (required on Vercel), pooled string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# ---- Live AI (optional) ----------------------------------------------
# Leave the key blank to run in Mock AI mode (the header toggle stays locked to Mock).
# Choose one provider: groq | cloudflare | watsonx
AI_PROVIDER=groq

# Groq: free key from https://console.groq.com/keys (paste after the =, no quotes or spaces)
GROQ_API_KEY=
# Required. Must be a model your Groq org can use (list: console.groq.com/docs/models).
# Alternative 8B model: llama-3.1-8b-instant (then leave GROQ_REASONING_EFFORT blank)
GROQ_MODEL=openai/gpt-oss-20b
# Reasoning models only (gpt-oss, qwen3): low | medium | high. Blank for non-reasoning models.
# Higher effort uses more tokens per call (free tier: about 8,000 tokens per minute).
GROQ_REASONING_EFFORT=low

# Cloudflare Workers AI: account ID from the dashboard, API token with "Workers AI" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Required for this provider. IBM Granite with function calling:
CLOUDFLARE_MODEL=@cf/ibm-granite/granite-4.0-h-micro

# IBM watsonx.ai
WATSONX_APIKEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
# Required for this provider:
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ---- Tuning (optional; checked at startup) ----------------------------
# Leave a value blank to use the code default shown in the comment.
# Live AI
AI_LIVE_CALLS_PER_SESSION=15     # default 25: live calls per browser session (saved/cached answers are free)
AI_CALL_TIMEOUT_SECONDS=45       # default 45: hard limit for one call or one whole agent run (5-300)
AI_AGENT_MAX_MODEL_CALLS=6       # default 6: model calls per assessment, 3 tool calls + answer + repair (2-20)
AI_AGENT_RECURSION_LIMIT=24      # default 24: agent graph steps (4-100)

# CV upload
CV_MAX_UPLOAD_MB=3               # default 10: largest accepted PDF in MB (1-50)
CV_MIN_WORDS_PER_PAGE=50         # default 50: fewer words per page = treated as scanned, no model call (0-1000)
CV_MAX_CHARS_SENT=15000          # default 15000: CV text beyond this is not sent to the model (1000-200000)

# Privacy
DATA_RETENTION_DAYS=30           # default 30: purge_expired_data deletes data not used for this many days (1-3650)

# Matching weights (0-100 each; rescaled to 100 over the rules that apply; 0 switches a rule off)
MATCH_WEIGHT_SKILLS=35           # default 35
MATCH_WEIGHT_EXPERIENCE=20       # default 20
MATCH_WEIGHT_LANGUAGE=15         # default 15
MATCH_WEIGHT_LOCATION=15         # default 15
MATCH_WEIGHT_EDUCATION=10        # default 10
MATCH_WEIGHT_INTERESTS=5         # default 5

# Experience = years score x relevance (profile experience areas vs the role's experience areas)
MATCH_EXPERIENCE_UNRELATED=0.25  # default 0.25: share of the years score kept when the areas don't overlap (0-1)
MATCH_EXPERIENCE_UNKNOWN=0.6     # default 0.6: share kept when the profile lists no experience areas (0-1)
